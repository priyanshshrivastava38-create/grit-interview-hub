# Local Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/grit"

# Optional: direct (non-pooled) URL used only by Prisma migrations.
# Set this when DATABASE_URL points at a pgbouncer transaction pooler.
# DIRECT_URL="postgresql://user:password@host:5432/grit"

# Session signing secret (32+ random characters).
# Recommended. In demo mode, if omitted, a stable key is derived from DATABASE_URL.
AUTH_SECRET="replace-with-a-long-random-string"

# Scheduling timezone used by interviewers and students
APP_TIMEZONE="Asia/Kolkata"

# Enables the demo login, demo personas and the reset-demo action.
# Set to "false" only when real authentication is wired in.
DEMO_MODE="true"

NEXT_PUBLIC_APP_NAME="GRIT Interview Hub"

# When deploying with Supabase, the pooled Postgres connection string is enough
# for this application. Auth is demo-only; Supabase Auth is a future integration.
